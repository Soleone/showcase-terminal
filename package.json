{
  "name": "@soleone/showcase-terminal",
  "version": "0.0.0",
  "description": "Build a static page that runs a CLI for real in the visitor's browser (WebContainers).",
  "license": "MIT",
  "author": "Soleone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/showcase-terminal.git"
  },
  "homepage": "https://github.com/Soleone/showcase-terminal#readme",
  "bugs": "https://github.com/Soleone/showcase-terminal/issues",
  "keywords": [
    "demo",
    "cli",
    "terminal",
    "webcontainers",
    "showcase"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/terminal.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "showcase-terminal": "./bin/showcase-terminal.js"
  },
  "files": [
    "bin/",
    "src/",
    "page/",
    "!page/fonts/build.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "release": "release-it",
    "release:dry-run": "npm test && release-it --dry-run"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "release-it": "^19.2.4"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.0"
    }
  }
}
